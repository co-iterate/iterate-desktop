{
  "name": "cunzhi",
  "type": "module",
  "version": "0.6.4",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm run lint:check",
    "lint:check": "eslint src/frontend",
    "lint:fix": "eslint src/frontend --fix",
    "oss:check": "node scripts/export-desktop-oss.mjs check .",
    "oss:export": "node scripts/export-desktop-oss.mjs export",
    "repo:hygiene": "node scripts/check-repo-hygiene.mjs",
    "test:desktop-oss-readiness": "node --test scripts/desktop-oss-readiness.test.mjs",
    "test:install-docs": "node --test scripts/install-docs-contract.test.mjs",
    "test:desktop-audio-privacy": "node --test scripts/desktop-audio-privacy.test.mjs",
    "test:desktop-web-push-security": "node --test scripts/desktop-bridge-web-push-security.test.mjs",
    "test:desktop-build-targets": "node --test scripts/desktop-build-rs-target-gating.test.mjs",
    "test:desktop-community-activation": "node --test scripts/desktop-community-activation.test.mjs",
    "test:windows-experience": "node --test scripts/windows-experience-contract.test.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:dev:no-watch": "cargo tauri dev --no-watch",
    "tauri:build": "cargo tauri build",
    "tauri:build:windows": "pwsh -NoProfile -File ./scripts/build-windows-installer.ps1",
    "desktop:install": "bash ./scripts/install-macos-dev-app.sh",
    "desktop:install:skip-build": "bash ./scripts/install-macos-dev-app.sh --skip-build",
    "delivery:macos": "bash ./scripts/prepare-macos-delivery.sh",
    "notarize:macos": "bash ./scripts/notarize-macos-app.sh",
    "release:readiness": "bash ./scripts/iterate-release-readiness-check.sh",
    "release:sign-assets": "node ./scripts/release-sign-assets.mjs",
    "release:parity": "bash ./scripts/iterate-release-parity-check.sh",
    "loop:impact": "node ./scripts/iterate-cross-platform-impact.mjs",
    "smoke:windows-package": "pwsh -NoProfile -File ./scripts/windows-install-smoke.ps1",
    "smoke:windows-installer": "pwsh -NoProfile -File ./scripts/windows-installer-smoke.ps1",
    "smoke:macos-manifest": "bash ./scripts/macos-manifest-smoke.sh",
    "smoke:macos-manifest:latest": "MANIFEST_URL=https://api.github.com/repos/kexin94yyds/iterate-releases/releases/latest bash ./scripts/macos-manifest-smoke.sh",
    "smoke:macos-manifest:latest:urls": "CHECK_URLS=1 MANIFEST_URL=https://api.github.com/repos/kexin94yyds/iterate-releases/releases/latest bash ./scripts/macos-manifest-smoke.sh",
    "smoke:macos-manifest:latest:downloads": "CHECK_URLS=1 CHECK_DOWNLOADS=1 HTTP_TIMEOUT_SECS=60 MANIFEST_URL=https://api.github.com/repos/kexin94yyds/iterate-releases/releases/latest bash ./scripts/macos-manifest-smoke.sh",
    "smoke:macos-manifest:latest:checksums": "CHECK_URLS=1 CHECK_DOWNLOADS=1 REQUIRE_CHECKSUM_ASSETS=1 HTTP_TIMEOUT_SECS=60 MANIFEST_URL=https://api.github.com/repos/kexin94yyds/iterate-releases/releases/latest bash ./scripts/macos-manifest-smoke.sh",
    "test": "pnpm run test:frontend && pnpm run test:scripts && pnpm run test:rust",
    "test:frontend": "pnpm run test:checkpoint-settings && pnpm run test:conversation-end && pnpm run test:submission-clipboard && pnpm run test:ghost-suggestions && pnpm run test:popup-header-codex-open && pnpm run test:desktop-codex-live && pnpm run test:popup-selection-quote && pnpm run test:local-markdown-links && pnpm run test:bridge-fetch && pnpm run test:mobile-connection && pnpm run test:mcp-response-speed && pnpm run test:speech-services",
    "test:frontend:interactive": "pnpm run test:ui",
    "test:checkpoint-settings": "node --test src/frontend/components/settings/CheckpointSettings.test.ts",
    "test:conversation-end": "node --test src/frontend/utils/conversationEndCommand.test.ts",
    "test:submission-clipboard": "node --test src/frontend/utils/submissionClipboard.test.ts",
    "test:ghost-suggestions": "node --test src/frontend/components/settings/GhostSuggestionSettings.test.ts src/frontend/utils/ghostSuggestionMatching.test.ts src/frontend/utils/ghostSuggestionOrdering.test.ts src/frontend/utils/ghostSuggestionAutoPromotion.test.ts src/frontend/utils/ghostSuggestionStoreSync.test.ts scripts/desktop-ghost-suggestion-priority.test.mjs scripts/popup-input-ghost-performance.test.mjs",
    "test:popup-header-codex-open": "node --test src/frontend/components/popup/PopupHeader.codexProjectOpen.test.ts",
    "test:desktop-codex-live": "node --test scripts/desktop-codex-live-source.test.mjs src/frontend/utils/latestTaskGuard.test.ts src/frontend/utils/latestValueTaskQueue.test.ts src/frontend/utils/codexLiveTranscript.test.ts src/frontend/utils/codexLiveVoiceDecision.test.ts src/frontend/utils/codexLiveHudText.test.ts src/frontend/utils/desktopCodexLiveHudGeometry.test.ts",
    "test:popup-selection-quote": "node --test src/frontend/utils/popupSelectionQuote.test.ts",
    "test:local-markdown-links": "node --test src/frontend/utils/localMarkdownLinks.test.ts",
    "test:bridge-fetch": "node --test src/frontend/services/bridgeFetch.test.ts",
    "test:mobile-connection": "node --test src/frontend/components/settings/mobileConnectionMachine.test.ts",
    "test:mcp-response-speed": "node --test src/frontend/composables/useMcpHandler.immediateDismiss.test.ts",
    "test:speech-services": "node --test src/frontend/services/speechContext.test.ts src/frontend/services/speechPostprocess.test.ts src/frontend/services/speechSemanticResolver.test.ts src/frontend/services/desktopSpeechRecognitionMode.test.ts src/frontend/services/globalSpeechSession.test.ts src/frontend/services/speechInsertGuard.test.ts && node --test scripts/desktop-speech-frontend-ownership.test.mjs",
    "test:bridge-daemon": "node --test scripts/install-bridge-daemon.test.mjs",
    "test:mermaid-security": "node --test scripts/mermaid-renderer-security-contract.test.mjs",
    "test:popup-discontiguous-selection": "node --test scripts/popup-discontiguous-selection-contract.test.mjs",
    "test:release-signing": "node --test scripts/release-sign-assets.test.mjs",
    "test:health-loop": "node --test scripts/iterate-health-loop.test.mjs",
    "test:health-daemon": "node --test scripts/iterate-health-daemon.test.mjs",
    "test:loop-contract-check": "node --test scripts/loop-contract-check.test.mjs",
    "test:mcp-tool-icons": "node --test scripts/mcp-tool-icon-safelist.test.mjs",
    "test:component-mcp-tools": "node --test scripts/frontend-component-mcp-tools.test.mjs",
    "test:security-regression": "bash ./scripts/iterate-security-regression-check.sh",
    "test:scripts": "pnpm run test:desktop-oss-readiness && pnpm run test:install-docs && pnpm run test:desktop-audio-privacy && pnpm run test:desktop-web-push-security && pnpm run test:desktop-build-targets && pnpm run test:desktop-community-activation && pnpm run test:windows-experience && pnpm run test:bridge-daemon && pnpm run test:mermaid-security && pnpm run test:popup-discontiguous-selection && pnpm run test:release-signing && pnpm run test:health-loop && pnpm run test:health-daemon && pnpm run test:loop-contract-check && pnpm run test:mcp-tool-icons && pnpm run test:component-mcp-tools",
    "test:rust": "node scripts/run-rust-tests.mjs",
    "test:ui": "cd src/frontend/test && vite",
    "test:ui:build": "cd src/frontend/test && vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-global-shortcut": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@types/markdown-it": "^14.1.2",
    "@vueuse/core": "^13.3.0",
    "@vueuse/integrations": "^13.4.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.17.0",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.16",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.14.1",
    "@iconify-json/carbon": "^1.2.9",
    "@tauri-apps/cli": "2.10.1",
    "@unocss/preset-attributify": "^66.2.1",
    "@unocss/preset-icons": "^66.2.1",
    "@unocss/preset-typography": "^66.2.1",
    "@unocss/preset-web-fonts": "^66.2.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.29.0",
    "eslint-plugin-format": "^1.0.1",
    "naive-ui": "^2.41.1",
    "unocss": "^66.2.1",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.13": "3.4.14",
      "brace-expansion@<2.0.0": "1.1.18",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "linkify-it@<5.0.2": "5.0.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.26"
    }
  }
}
